{
  "manifest_version": 3,
  "name": "Discontrol",
  "description": "Controle chamadas do Discord Web em uma janela flutuante. Projeto independente por devsantos.",
  "version": "0.6.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Abrir Discontrol",
    "default_icon": {
      "16": "icons/discontrol-16.png",
      "32": "icons/discontrol-32.png",
      "48": "icons/discontrol-48.png"
    }
  },
  "icons": {
    "16": "icons/discontrol-16.png",
    "32": "icons/discontrol-32.png",
    "48": "icons/discontrol-48.png",
    "128": "icons/discontrol-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
